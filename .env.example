# Copy to .env (or run scripts/gen-env.sh, which fills random values).
# Lab only: these values configure throw-away containers on internal Docker networks.

# traditional | proposed. COMPOSE_PROFILES must be "proposed" in proposed mode (it starts
# Keycloak and the IDS) and empty in traditional mode.
SDP_MODE=proposed
COMPOSE_PROFILES=proposed

KC_ADMIN_PASSWORD=change-me
KC_CONTROLLER_SECRET=change-me

ALICE_PASSWORD=change-me
ALICE_OTP_SECRET=change-me-change-me1
BOB_PASSWORD=change-me
BOB_OTP_SECRET=change-me-change-me2
CAROL_PASSWORD=change-me
CAROL_OTP_SECRET=change-me-change-me3
BENCH_PASSWORD=change-me
BENCH_OTP_SECRET=change-me-change-me4
